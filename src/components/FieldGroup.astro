---
import katex from "katex";
import macros from "katex-physics";
import { katexMacros } from "../../katex-macros.ts";
import type { Field } from "../data/fields";

interface Props {
  field: Field;
}

const { field } = Astro.props;

function renderMath(text: string) {
  return text.replace(/\$([^$]+)\$/g, (_, math) =>
    katex.renderToString(math, {
      throwOnError: false,
      trust: true,
      strict: "ignore",
      macros: {
        ...katexMacros,
        ...macros,
      },
    }),
  );
}
---

<div class="field-browser" data-field-browser={field.id}>
  <nav class="field-section-nav" aria-label={`${field.title}の分野`}>
    {
      field.sections.map((section, index) => (
        <button
          type="button"
          class="field-section-button"
          data-section-button={index}
          aria-selected={index === 0 ? "true" : "false"}
        >
          {section.title}
        </button>
      ))
    }
  </nav>

  <div class="field-section-content">
    {
      field.sections.map((section, index) => (
        <section
          class="field-section-panel"
          data-section-panel={index}
          hidden={index !== 0}
          aria-label={section.title}
        >

          {section.items && section.items.length > 0 ? (
            <ul class="topic-list">
              {section.items.map((item) => (
                <li class={`topic-item level-${item.level ?? 0}`}>
                  <Fragment set:html={renderMath(item.title)} />
                </li>
              ))}
            </ul>
          ) : (
            <p class="field-empty">項目はまだありません。</p>
          )}
        </section>
      ))
    }
  </div>
</div>