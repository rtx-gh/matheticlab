---
interface Props {
  type:
    | "theorem"
    | "proposition"
    | "corollary"
    | "lemma"
    | "definition"
    | "axiom"
    | "example";
  title?: string;
}

const { type, title } = Astro.props;

const labels = {
  theorem: "定理",
  proposition: "命題",
  corollary: "系",
  lemma: "補題",
  definition: "定義",
  axiom: "公理",
  example: "例",
} as const;

const label = labels[type];
---

<div class={`math-box ${type}`}>
  <div class="math-box-title">
    <span class="math-box-label">{label}</span>
    {title && <span class="math-box-name">：{title}</span>}
  </div>

  <div class="math-box-body">
    <slot />
  </div>
</div>

<style>
  /*
   * ========================================
   * Math Box
   * ========================================
   *
   * theorem     : 青
   * proposition : 赤
   * corollary   : オレンジ
   * lemma       : 茶
   * definition  : 緑
   * axiom       : 紫
   * example     : 山吹
   */

  .math-box {
    --box-color: #666;
    --box-background: #f5f5f5;
    --box-title-color: #333;

    margin: 1.5rem 0;
    border: 1px solid var(--box-color);
    border-radius: 6px;
    overflow: hidden;
  }

  /*
   * タイトル
   */
  .math-box-title {
    padding: 0.55rem 0.85rem;
    background: var(--box-background);
    color: var(--box-title-color);
    font-weight: 700;
    line-height: 1.5;
  }

  .math-box-label {
    font-weight: 700;
  }

  .math-box-name {
    font-weight: 700;
  }

  /*
   * 本文
   */
  .math-box-body {
    padding: 0.8rem 1rem;
  }

  /*
   * 本文先頭・末尾の余白を除去
   */
  .math-box-body :global(> :first-child) {
    margin-top: 0;
  }

  .math-box-body :global(> :last-child) {
    margin-bottom: 0;
  }

  /*
   * ========================================
   * 定理：青
   * ========================================
   */
  .theorem {
    --box-color: #1976d2;
    --box-background: #e3f2fd;
    --box-title-color: #1565c0;
  }

  /*
   * ========================================
   * 命題：赤
   * ========================================
   */
  .proposition {
    --box-color: #d32f2f;
    --box-background: #ffebee;
    --box-title-color: #c62828;
  }

  /*
   * ========================================
   * 系：オレンジ
   * ========================================
   */
  .corollary {
    --box-color: #f57c00;
    --box-background: #fff3e0;
    --box-title-color: #e65100;
  }

  /*
   * ========================================
   * 補題：茶色
   * ========================================
   */
  .lemma {
    --box-color: #795548;
    --box-background: #efebe9;
    --box-title-color: #5d4037;
  }

  /*
   * ========================================
   * 定義：緑
   * ========================================
   */
  .definition {
    --box-color: #388e3c;
    --box-background: #e8f5e9;
    --box-title-color: #2e7d32;
  }

  /*
   * ========================================
   * 公理：紫
   * ========================================
   */
  .axiom {
    --box-color: #7b1fa2;
    --box-background: #f3e5f5;
    --box-title-color: #6a1b9a;
  }

  /*
   * ========================================
   * 例：山吹色
   * ========================================
   */
  .example {
    --box-color: #d9a400;
    --box-background: #fff8dc;
    --box-title-color: #8a6500;
  }

  /*
   * ========================================
   * ダークモード
   * ========================================
   */

  :global([data-theme="dark"]) .theorem {
    --box-background: rgb(25 118 210 / 12%);
    --box-title-color: #64b5f6;
  }

  :global([data-theme="dark"]) .proposition {
    --box-background: rgb(211 47 47 / 12%);
    --box-title-color: #ef5350;
  }

  :global([data-theme="dark"]) .corollary {
    --box-background: rgb(245 124 0 / 12%);
    --box-title-color: #ff9800;
  }

  :global([data-theme="dark"]) .lemma {
    --box-background: rgb(121 85 72 / 18%);
    --box-title-color: #bcaaa4;
  }

  :global([data-theme="dark"]) .definition {
    --box-background: rgb(56 142 60 / 12%);
    --box-title-color: #66bb6a;
  }

  :global([data-theme="dark"]) .axiom {
    --box-background: rgb(123 31 162 / 15%);
    --box-title-color: #ba68c8;
  }

  :global([data-theme="dark"]) .example {
    --box-background: rgb(217 164 0 / 12%);
    --box-title-color: #fbc02d;
  }
</style>