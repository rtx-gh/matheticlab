<script>
  const detailsList =
    document.querySelectorAll<HTMLDetailsElement>('.accordion details');

  detailsList.forEach((details) => {
    details.addEventListener('toggle', () => {
      if (!details.open) return;

      requestAnimationFrame(() => {
        details.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        });
      });
    });
  });
</script>
