---
import FieldGroup from "./FieldGroup.astro";
import { fields } from "../data/fields";
---

<div class="accordion">
  {fields.map((field) => <FieldGroup field={field} />)}
</div>

<script>
  document
    .querySelectorAll<HTMLDetailsElement>(".accordion details")
    .forEach((details) => {
      details.addEventListener("toggle", () => {
        if (!details.open) return;

        requestAnimationFrame(() => {
          details.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        });
      });
    });
</script>